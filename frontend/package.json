    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "swagger-ui-dist": "5.33.0",
    "tailwindcss": "4.1.5",
    "typescript": "5.8.3",
